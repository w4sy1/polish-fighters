<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pf_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:gravity="center_horizontal" android:background="@drawable/pf_background">
 <TextView android:layout_width="match_parent" android:layout_height="38dp" android:text="POLISH LITTLE FIGHTERS" android:textColor="#F4F5FF" android:textSize="22sp" android:textStyle="bold|italic" android:fontFamily="monospace" android:gravity="center"/>
 <View android:layout_width="220dp" android:layout_height="2dp" android:background="#EF253C" android:layout_marginBottom="9dp"/>
 <io.github.openlf2.openlf2.ClassicColumn android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_play" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="BITWA" android:backgroundTint="@null"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_module" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="MODUŁY" android:backgroundTint="@null"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_network" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="GRA ONLINE" android:backgroundTint="@null"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_settings" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="USTAWIENIA" android:backgroundTint="@null"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_language" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="JĘZYK" android:backgroundTint="@null"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_credits" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="TWÓRCY" android:backgroundTint="@null"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_quit" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="5dp" android:text="WYJŚCIE" android:backgroundTint="@null"/>
 </io.github.openlf2.openlf2.ClassicColumn>
 <TextView android:id="@+id/pf_status" android:layout_width="match_parent" android:layout_height="20dp" android:text="@string/pf_ready" android:textColor="#C0D0EF" android:textSize="11sp" android:gravity="center" android:accessibilityLiveRegion="polite"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="right" android:orientation="horizontal">
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_pl" style="@style/PFAction" android:layout_width="58dp" android:layout_height="match_parent" android:text="PL" android:backgroundTint="@null"/>
 <Space android:layout_width="6dp" android:layout_height="1dp"/>
 <io.github.openlf2.openlf2.ClassicButton android:id="@+id/pf_en" style="@style/PFAction" android:layout_width="58dp" android:layout_height="match_parent" android:text="EN" android:backgroundTint="@null"/>
 </LinearLayout>
 <Button android:id="@+id/pf_cancel" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" android:text="@string/pf_cancel"/>
</LinearLayout>