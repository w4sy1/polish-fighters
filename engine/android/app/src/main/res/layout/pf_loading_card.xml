<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/pf_card">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pf_loading_tag" android:textSize="11sp" android:letterSpacing="0.08" android:textColor="#6CE1C3"/>
 <TextView android:id="@+id/pf_loading_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/pf_loading_title" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="@color/pf_text"/>
 <TextView android:id="@+id/pf_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/pf_loading_initial" android:textSize="15sp" android:textColor="@color/pf_muted" android:lineSpacingExtra="3dp" android:accessibilityLiveRegion="polite"/>
 <TextView android:id="@+id/pf_loading_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/pf_zero_percent" android:textColor="@color/pf_text" android:textSize="18sp" android:gravity="end"/>
 <ProgressBar android:id="@+id/pf_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:progressDrawable="@drawable/pf_progress" android:progressTint="@null"/>
 <TextView android:id="@+id/pf_loading_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/pf_loading_note" android:textSize="11sp" android:textColor="@color/pf_muted"/>
 <Button android:id="@+id/pf_retry" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="@string/pf_retry" android:visibility="gone" android:background="@drawable/pf_primary" android:backgroundTint="@null"/>
 <Button android:id="@+id/pf_updates" style="@style/PFAction" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="@string/pf_update" android:visibility="gone" android:backgroundTint="@null"/>
</LinearLayout>
